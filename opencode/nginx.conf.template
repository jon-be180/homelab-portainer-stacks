map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    server_name _;

    # OpenCode attachments and agent output can be larger than nginx's 1 MiB default.
    client_max_body_size 0;

    # Resolve the service name at request time so nginx survives an OpenCode
    # container recreation that changes its IP address.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $opencode_backend http://opencode:3000;

    location / {
        proxy_pass $opencode_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # OpenCode V2 always requires Basic authentication. Inject the internal
        # credential here so browsers do not receive a username/password prompt.
        proxy_set_header Authorization "Basic __OPENCODE_BASIC_AUTH__";

        # Preserve WebSocket upgrades and do not buffer the SSE event stream.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
